<h2>{{ text_instruction }}</h2>
<div class="well well-sm">
  <p>{{ text_redirect }}</p>
  {% if test %}<p class="text-warning"><b>{{ text_test }}</b></p>{% endif %}
</div>
<div id="arionpay-error"></div>
<div class="buttons">
  <div class="pull-right">
    <input type="button" value="{{ button_confirm }}" id="button-confirm" data-loading-text="{{ text_loading }}" class="btn btn-primary" />
  </div>
</div>
<script type="text/javascript"><!--
$('#button-confirm').on('click', function () {
	$.ajax({
		url: 'index.php?route=extension/payment/arionpay/confirm',
		dataType: 'json',
		beforeSend: function () { $('#button-confirm').button('loading'); },
		success: function (json) {
			if (json['error']) {
				$('#button-confirm').button('reset');
				$('#arionpay-error').html('').append($('<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> </div>').append(document.createTextNode(json['error'])));
			}
			if (json['redirect']) {
				location = json['redirect'];
			}
		},
		error: function (xhr, ajaxOptions, thrownError) {
			$('#button-confirm').button('reset');
			console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
		}
	});
});
//--></script>
